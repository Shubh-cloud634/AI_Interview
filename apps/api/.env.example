# Copy to apps/api/.env and fill in the three REPLACE values. Never commit .env.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
WORKERS_ENABLED=true

# Supabase project "ai-interview" (public values, already correct).
SUPABASE_URL=https://zwhjpdrhvikrolfixzhn.supabase.co

# REPLACE: Supabase dashboard > Project Settings > API > service_role key (server only, secret).
SUPABASE_SERVICE_ROLE_KEY=REPLACE
# REPLACE: Supabase dashboard > Connect > Direct connection / Session pooler URI, with your database password.
DATABASE_URL=REPLACE
# AI provider. Gemini has a free tier: create a key at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
# REPLACE: your Gemini API key.
GEMINI_API_KEY=REPLACE
# Optional model overrides (defaults: gemini-flash-latest and gemini-flash-lite-latest).
# AI_MODEL=
# AI_REVIEW_MODEL=
# To use Claude instead: AI_PROVIDER=anthropic and ANTHROPIC_API_KEY=...

RESUME_BUCKET=resumes
