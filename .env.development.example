# DEVELOPMENT environment. Copy to .env.development (gitignored by .dockerignore and must be by
# .gitignore) and fill in. Placeholders only: nothing in this file is a real credential.
#
# Variable names come from apps/api/src/config.ts (api, worker), apps/api/src/db/migrate-cli.ts
# (migrate), apps/web (web build args) and the proposed runner contract (docs/deployment.md).
# Use a DEDICATED dev Supabase project or `supabase start`. Never reuse staging/production keys here.

# ---------------------------------------------------------------- api + worker (apps/api/src/config.ts)
NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
PORT=4000
# Comma-separated exact origins.
CORS_ORIGINS=http://localhost:3000
# docker-compose.yml overrides this to point at the compose postgres service.
DATABASE_URL=postgres://app:dev-only-postgres@localhost:5432/ai_interview
# true runs the queue inside the api process; compose sets false on api and runs a worker service.
WORKERS_ENABLED=true

# `supabase start` prints these. host.docker.internal reaches the host from inside compose.
SUPABASE_URL=http://host.docker.internal:54321
# Optional (legacy HS256 projects only). When unset, tokens are verified against the project's JWKS.
SUPABASE_JWT_SECRET=
# Server-only. Required for resume upload/download and account deletion.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-supabase-service-role-key
RESUME_BUCKET=resumes

AI_PROVIDER=anthropic
# Required unless NODE_ENV=test. Use a dev key with a low spend limit.
ANTHROPIC_API_KEY=replace-with-dev-anthropic-key
AI_MODEL=claude-opus-5-5
AI_REVIEW_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_DAILY_TOKEN_BUDGET=300000
AI_REVIEW_MIN_STAGE_WEIGHT=0.3
AI_DISAGREEMENT_THRESHOLD=0.25

# Scheduler contract listener. compose binds it to the api's sandbox-network address.
INTERNAL_HOST=127.0.0.1
INTERNAL_PORT=4001
RUN_RESULT_WAIT_MS=120000

RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_RUN_PER_MIN=10

# ---------------------------------------------------------------- web (build args, public by design)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# ---------------------------------------------------------------- runner (TODO(runner): reconcile names)
# Set by infra/scripts/register-runner.sh. The private key is a file, never an env value.
RUNNER_ID=
SANDBOX_ADAPTER=docker

# ---------------------------------------------------------------- compose only
POSTGRES_USER=app
POSTGRES_PASSWORD=dev-only-postgres
POSTGRES_DB=ai_interview
