# STAGING environment. TEMPLATE ONLY: real values live in the secret manager under the path
# ai-interview/staging/<service>/<VAR> and are rendered to /run/ai-interview/<service>.env at deploy
# time. Never commit a filled copy. Staging has its OWN Supabase project, database, AI key, bucket
# and runner keys: no credential is shared with production or development.
#
# Staging runs NODE_ENV=production so it exercises the same code paths as production
# (apps/api config only knows development|test|production). APP_ENV distinguishes it for infra.
# Values marked SECRET come from the secret manager; the rest are plain configuration.
# Validate a rendered file with: node infra/scripts/check-env.mjs staging <file>

APP_ENV=staging

# ================================================================ api.env (apps/api/src/config.ts)
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=https://app.staging.example.com
# SECRET. Least-privilege runtime role (not the owner/migration role). TLS required.
DATABASE_URL=postgres://app_runtime:SECRET_FROM_SECRET_MANAGER@db.staging-ref.supabase.co:5432/postgres?sslmode=require
WORKERS_ENABLED=false
SUPABASE_URL=https://staging-ref.supabase.co
# SECRET, optional (legacy HS256 only). Prefer JWKS: leave unset.
SUPABASE_JWT_SECRET=
# SECRET.
SUPABASE_SERVICE_ROLE_KEY=SECRET_FROM_SECRET_MANAGER
RESUME_BUCKET=resumes
AI_PROVIDER=anthropic
# SECRET. Staging key with its own spend limit.
ANTHROPIC_API_KEY=SECRET_FROM_SECRET_MANAGER
AI_MODEL=claude-opus-5-5
AI_REVIEW_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_DAILY_TOKEN_BUDGET=300000
AI_REVIEW_MIN_STAGE_WEIGHT=0.3
AI_DISAGREEMENT_THRESHOLD=0.25
INTERNAL_HOST=0.0.0.0
INTERNAL_PORT=4001
RUN_RESULT_WAIT_MS=120000
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_RUN_PER_MIN=10

# ================================================================ worker.env
# Same variables as api.env, with WORKERS_ENABLED irrelevant (src/worker.ts always runs workers).
# The worker needs DATABASE_URL, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY and the
# AI_* settings. It does not need CORS_ORIGINS, HOST/PORT or INTERNAL_*.

# ================================================================ migrate.env
# SECRET. Owner role that may run DDL. Used only by the migrate job, never by api/worker.
# DATABASE_URL=postgres://app_owner:SECRET_FROM_SECRET_MANAGER@db.staging-ref.supabase.co:5432/postgres?sslmode=require

# ================================================================ web (build args, public by design)
NEXT_PUBLIC_API_URL=https://api.staging.example.com
NEXT_PUBLIC_SUPABASE_URL=https://staging-ref.supabase.co
# Public anon key (protected by RLS). Not a secret, but still staging-only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=PUBLIC_ANON_KEY_FROM_SUPABASE_DASHBOARD

# ================================================================ compose / proxy (docker-compose.prod.yml)
REGISTRY=ghcr.io/your-org
IMAGE_TAG=git-sha-set-by-pipeline
APP_DOMAIN=app.staging.example.com
API_DOMAIN=api.staging.example.com
ACME_EMAIL=ops@example.com
SUPABASE_HOST=staging-ref.supabase.co
SCHEDULER_BIND_ADDR=10.20.0.10

# ================================================================ runner host (TODO(runner): reconcile names)
# RUNNER_ID=uuid-from-register-runner
# SCHEDULER_URL=https://10.20.0.10:4001
# SANDBOX_ADAPTER=gvisor
# Private key: file /run/ai-interview/runner_key.pem rendered from the secret manager (SECRET).
