# PRODUCTION environment. TEMPLATE ONLY: real values live in the secret manager under
# ai-interview/production/<service>/<VAR> and are rendered to /run/ai-interview/<service>.env (tmpfs,
# mode 0600) by the deploy job. Never commit a filled copy, never paste production values into CI
# logs, tickets or chat.
#
# Fail closed: the deploy job runs `node infra/scripts/check-env.mjs production <file>` and aborts on
# any placeholder, localhost/wildcard CORS, missing TLS on DATABASE_URL, debug logging, missing AI or
# service-role key, or NODE_ENV other than production. docker-compose.prod.yml also uses ${VAR:?}.
# Production credentials are never shared with staging or development.

APP_ENV=production

# ================================================================ api.env (apps/api/src/config.ts)
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=4000
# Exact origins only, https only, comma-separated. No wildcard, no localhost, no preview URLs.
CORS_ORIGINS=https://app.example.com
# SECRET. Runtime role: no DDL, no BYPASSRLS, no superuser. TLS required.
DATABASE_URL=postgres://app_runtime:SECRET_FROM_SECRET_MANAGER@db.prod-ref.supabase.co:5432/postgres?sslmode=require
WORKERS_ENABLED=false
SUPABASE_URL=https://prod-ref.supabase.co
# SECRET, optional (legacy HS256 only). Prefer JWKS verification: leave unset.
SUPABASE_JWT_SECRET=
# SECRET. Bypasses RLS on storage and auth admin: api and worker only, never the web app.
SUPABASE_SERVICE_ROLE_KEY=SECRET_FROM_SECRET_MANAGER
RESUME_BUCKET=resumes
AI_PROVIDER=anthropic
# SECRET. Production key; provider-side spend limit set.
ANTHROPIC_API_KEY=SECRET_FROM_SECRET_MANAGER
AI_MODEL=claude-opus-5-5
AI_REVIEW_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_DAILY_TOKEN_BUDGET=300000
AI_REVIEW_MIN_STAGE_WEIGHT=0.3
AI_DISAGREEMENT_THRESHOLD=0.25
INTERNAL_HOST=0.0.0.0
INTERNAL_PORT=4001
RUN_RESULT_WAIT_MS=120000
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_RUN_PER_MIN=10

# ================================================================ worker.env
# Same as api.env minus CORS_ORIGINS, HOST, PORT, INTERNAL_*. Needs DATABASE_URL, SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY, AI_*.

# ================================================================ migrate.env
# SECRET. Owner role, used only by the migrate job behind the production approval gate.
# DATABASE_URL=postgres://app_owner:SECRET_FROM_SECRET_MANAGER@db.prod-ref.supabase.co:5432/postgres?sslmode=require

# ================================================================ web (build args, public by design)
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_SUPABASE_URL=https://prod-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PUBLIC_ANON_KEY_FROM_SUPABASE_DASHBOARD

# ================================================================ compose / proxy (docker-compose.prod.yml)
REGISTRY=ghcr.io/your-org
IMAGE_TAG=git-sha-set-by-pipeline
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
SUPABASE_HOST=prod-ref.supabase.co
SCHEDULER_BIND_ADDR=10.10.0.10

# ================================================================ runner host (TODO(runner): reconcile names)
# RUNNER_ID=uuid-from-register-runner
# SCHEDULER_URL=https://10.10.0.10:4001
# SANDBOX_ADAPTER=gvisor   # or firecracker. "docker" is rejected in production.
# Private key: file /run/ai-interview/runner_key.pem rendered from the secret manager (SECRET).
